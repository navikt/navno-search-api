              "kontakt, skriv",
              "pensjon, pensjonist",
              "jobb, stilling",
              "betvil, bestrid",
              "attlev, gjenlev",
              "eins, ens",
              "heim, hjem",
              "månad, måned",
              "naudssituasjon, nødssituasjon",
              "rettlei, veiled, veil",
              "rettleiing, veiledning",
              "sjuk, syk",
              "skul, skol",
              "tilskot, tilskudd",
              "vek, uke",
              "verksemd, virksom",
              "klagerett, erstatning",
              "serviceklag, klag servic",
              "reiseutgift, reisereging"
