              "remove_zero_width_space"
            ],
            "filter": [
              "english_possessive_stemmer",
              "lowercase",
              "english_stop",
              "english_stemmer"
            ],
            "tokenizer": "standard",
            "type": "custom"
          },
          "custom_norwegian_index": {
            "char_filter": [
              "remove_soft_hyphen",
              "remove_zero_width_space"
            ],
            "filter": [
              "lowercase",
              "norwegian_stop",
              "norwegian_stemmer",
              "norwegian_synonyms"
            ],
            "tokenizer": "letter",
            "type": "custom"
          },
          "custom_norwegian_ngrams": {
            "char_filter": [
              "remove_soft_hyphen",
              "remove_zero_width_space"
            ],
            "filter": [
              "lowercase",
              "norwegian_stop",
              "norwegian_stemmer",
              "ngram_multiplexer",
              "unique"
            ],
            "tokenizer": "letter",
            "type": "custom"
          },
          "custom_norwegian_search": {
            "char_filter": [
              "remove_soft_hyphen",
              "remove_zero_width_space"
            ],
            "filter": [
              "lowercase",
              "norwegian_stop",
              "norwegian_stemmer"
            ],
            "tokenizer": "letter",
            "type": "custom"
          },
          "custom_standard": {
            "char_filter": [
              "remove_soft_hyphen",
              "remove_zero_width_space"
            ],
            "filter": [
              "lowercase"
            ],
            "tokenizer": "standard",
            "type": "custom"
          }
        },
        "char_filter": {
          "remove_soft_hyphen": {
            "pattern": "­",
            "replacement": "",
            "type": "pattern_replace"
          },
          "remove_zero_width_space": {
            "pattern": "​",
            "replacement": "",
            "type": "pattern_replace"
          }
        },
        "filter": {
          "back_edge_ngram": {
            "max_gram": "20",
            "min_gram": "6",
            "side": "back",
            "type": "edge_ngram"
          },
          "english_possessive_stemmer": {
            "language": "possessive_english",
            "type": "stemmer"
          },
          "english_stemmer": {
            "language": "english",
            "type": "stemmer"
          },
          "english_stop": {
            "stopwords": "_english_",
            "type": "stop"
          },
          "front_edge_ngram": {
            "max_gram": "20",
            "min_gram": "3",
            "side": "front",
            "type": "edge_ngram"
          },
          "ngram_multiplexer": {
            "filters": [
              "front_edge_ngram",
              "back_edge_ngram"
            ],
            "type": "multiplexer"
          },
          "norwegian_stemmer": {
            "language": "norwegian",
            "type": "stemmer"
          },
          "norwegian_stop": {
            "stopwords": "_norwegian_",
            "type": "stop"
          },
          "norwegian_synonyms": {
            "synonyms": [
              "søk, søknad",
